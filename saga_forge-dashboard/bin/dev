#!/usr/bin/env bash
# Run the dashboard preview locally: compiles the stylesheet, then boots the
# seeded Combustion app (config.ru) on http://localhost:$PORT/saga_forge.
set -e
cd "$(dirname "$0")/.."

bundle exec rake tailwind:build
echo "SagaForge dashboard -> http://localhost:${PORT:-9977}/saga_forge"
exec bundle exec rackup -p "${PORT:-9977}"
